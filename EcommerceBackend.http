@hostname = localhost
@port = 5062
@baseUrl = http://{{hostname}}:{{port}}

# -------------------------------------------------------------------------
# Реальные тестовые ID из базы данных Supabase (каждый запрос работает сразу в 1 клик!)
# -------------------------------------------------------------------------
@categoryId = 66121fb2-d362-446a-9205-fdefcaf08fef
@supplierId = 06675cc5-f9c9-42c8-8eef-74bae08260c6
@productId = 00818889-1692-45e8-8462-dd3d519db737
@orderId = c2461c5f-500d-4962-b62e-8e125e02eeb3
@orderPublicId = 686c90ce12bf427abce30ed034f919ba
@adminDaniilId = b8fb4440-3f56-4164-852d-f0e209b32d0a
@adminToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..60VGkNN0Cbw0coHBhHPmvLEKPWJfku4TWGSVVL0ppzE


### =========================================================================
### Категории и поставщики
### =========================================================================

### 1. Справочник поставщиков
GET {{baseUrl}}/api/suppliers
Accept: application/json

### 2. Получить все активные категории
GET {{baseUrl}}/api/categories?onlyActive=true
Accept: application/json

### 3. Создать новую категорию
# @name createCategory
POST {{baseUrl}}/api/categories
Content-Type: application/json

{
  "name": "Праздничный декор 2026",
  "slug": "prazdnichnyj-dekor-2026",
  "parentId": null,
  "sortOrder": 1,
  "isActive": true,
  "metaTitle": "Праздничный декор 2026",
  "metaDescription": "Ёлки, гирлянды и украшения"
}

### 4. Получить категорию по реальному ID
GET {{baseUrl}}/api/categories/{{categoryId}}
Accept: application/json

### 5. Найти категорию по slug
GET {{baseUrl}}/api/categories/by-slug/garlands
Accept: application/json

### 6. ОШИБКА: создать категорию с уже занятым slug (ожидается 409 Conflict)
POST {{baseUrl}}/api/categories
Content-Type: application/json

{
  "name": "Дубль гирлянд",
  "slug": "garlands",
  "parentId": null,
  "sortOrder": 1,
  "isActive": true
}

### 7. Обновить категорию по ID
PUT {{baseUrl}}/api/categories/{{categoryId}}
Content-Type: application/json

{
  "name": "Гирлянды, свет и иллюминация",
  "slug": "garlands",
  "parentId": null,
  "sortOrder": 2,
  "isActive": true,
  "metaTitle": "Гирлянды, свет и иллюминация",
  "metaDescription": "Всё для праздничного освещения дома"
}


### =========================================================================
### Каталог товаров (Витрина)
### =========================================================================

### 8. Получить все товары (каталог)
GET {{baseUrl}}/api/products
Accept: application/json

### 9. Каталог: поиск по слову
GET {{baseUrl}}/api/products?Search=гирлянда
Accept: application/json

### 10. Каталог: сортировка по возрастанию цены
GET {{baseUrl}}/api/products?SortBy=price_asc
Accept: application/json

### 11. Каталог: пагинация — страница 1 по 5 товаров
GET {{baseUrl}}/api/products?PageNumber=1&PageSize=5
Accept: application/json

### 12. Создать новый товар (Ёлка)
POST {{baseUrl}}/api/products
Content-Type: application/json

{
  "categoryId": "{{categoryId}}",
  "supplierId": "{{supplierId}}",
  "sku": "DEMO-TREE-2026",
  "name": "Искусственная ёлка Премиум 210 см",
  "slug": "elka-premium-210-sm",
  "description": "Пышная литая искусственная ёлка",
  "dropPrice": 2500.00,
  "price": 4200.00,
  "oldPrice": 4800.00,
  "stock": 15,
  "mainImageUrl": "https://images.unsplash.com/photo-1512389142860-9c449e58a543?auto=format&fit=crop&w=1200&q=80",
  "isActive": true
}

### 13. Создать светодиодную гирлянду
POST {{baseUrl}}/api/products
Content-Type: application/json

{
  "categoryId": "{{categoryId}}",
  "supplierId": "{{supplierId}}",
  "sku": "DEMO-GARLAND-2026",
  "name": "Светодиодная гирлянда Нить Роса 20 м",
  "slug": "girlyanda-nit-rosa-20m",
  "description": "Тёплый белый свет, 200 micro-LED",
  "dropPrice": 280.00,
  "price": 650.00,
  "stock": 50,
  "isActive": true
}

### 14. Получить товар по реальному ID
GET {{baseUrl}}/api/products/{{productId}}
Accept: application/json

### 15. Обновить товар
PUT {{baseUrl}}/api/products/{{productId}}
Content-Type: application/json

{
  "categoryId": "{{categoryId}}",
  "supplierId": "{{supplierId}}",
  "sku": "NY-0008",
  "name": "Гирлянда «Свечи» на батарейках 2 м (Обновленная)",
  "slug": "gerlyanda-sveshi",
  "description": "Атмосферная гирлянда для новогоднего стола",
  "dropPrice": 150.00,
  "price": 380.00,
  "stock": 45,
  "isActive": true
}


### =========================================================================
### Оформление заказа (Витрина)
### =========================================================================

### 16. Оформить заказ клиентом (гостевой чекаут)
# @name checkoutOrder
POST {{baseUrl}}/api/orders
Content-Type: application/json

{
  "fullName": "Олена Коваль",
  "customerPhone": "+380991234567",
  "customerEmail": "olena@example.com",
  "customerComment": "Гостьове замовлення через витрину",
  "deliveryType": "Відділення",
  "deliveryCityName": "Київ",
  "deliveryWarehouseName": "Відділення №12",
  "paymentMethod": "CashOnDelivery",
  "items": [
    {
      "productId": "{{productId}}",
      "quantity": 1
    }
  ]
}

### 17. Просмотр заказа клиентом по publicId (страница «Спасибо за заказ»)
GET {{baseUrl}}/api/orders/by-public-id/{{orderPublicId}}
Accept: application/json

### 18. Получить заказ по ID
GET {{baseUrl}}/api/orders/{{orderId}}
Accept: application/json


### =========================================================================
### Админка: JWT Авторизация по логину
### =========================================================================

### 19. Вход администратора gryftd (Даниил)
# @name adminLogin
POST {{baseUrl}}/api/admin/auth/login
Content-Type: application/json

{
  "username": "gryftd",
  "password": "Admin12345!"
}

### 20. Вход администратора Nesh10n (Саша)
POST {{baseUrl}}/api/admin/auth/login
Content-Type: application/json

{
  "username": "Nesh10n",
  "password": "Admin12345!"
}

### 21. Вход администратора var404 (Максим)
POST {{baseUrl}}/api/admin/auth/login
Content-Type: application/json

{
  "username": "var404",
  "password": "Admin12345!"
}

### 22. Профиль текущего администратора (Bearer Token)
GET {{baseUrl}}/api/admin/auth/me
Authorization: Bearer {{adminToken}}
Accept: application/json

### 23. Список всех администраторов команды
GET {{baseUrl}}/api/admin/auth/admins
Authorization: Bearer {{adminToken}}
Accept: application/json


### =========================================================================
### Админ-панель: Управление товарами (/api/admin/products)
### =========================================================================

### 24. Админка: получить все товары (включая неактивные/скрытые)
GET {{baseUrl}}/api/admin/products?pageNumber=1&pageSize=20
Authorization: Bearer {{adminToken}}
Accept: application/json

### 25. Админка: детальная информация о товаре для формы редактирования
GET {{baseUrl}}/api/admin/products/{{productId}}
Authorization: Bearer {{adminToken}}
Accept: application/json

### 26. Админка: быстрое обновление остатка товара на складе (PATCH /stock)
PATCH {{baseUrl}}/api/admin/products/{{productId}}/stock
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "stockQuantity": 88
}

### 27. Админка: мягкое удаление товара (IsActive = false)
DELETE {{baseUrl}}/api/admin/products/{{productId}}
Authorization: Bearer {{adminToken}}


### =========================================================================
### Админ-панель: Управление заказами (/api/admin/orders)
### =========================================================================

### 28. Админка: список заказов с фильтрами по статусу и диапазону дат
GET {{baseUrl}}/api/admin/orders?pageNumber=1&pageSize=20
Authorization: Bearer {{adminToken}}
Accept: application/json

### 29. Админка: поиск заказов по имени или номеру телефона
GET {{baseUrl}}/api/admin/orders?search=Олена
Authorization: Bearer {{adminToken}}
Accept: application/json

### 30. Админка: полная информация о заказе (контакты, себестоимость, прибыль, история статусов)
GET {{baseUrl}}/api/admin/orders/{{orderId}}
Authorization: Bearer {{adminToken}}
Accept: application/json

### 31. Админка: смена статуса заказа с записью в историю (OrderStatusHistory)
PATCH {{baseUrl}}/api/admin/orders/{{orderId}}/status
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "status": "Shipped",
  "comment": "Передано в службу доставки Новая Почта (ТТН 20450912345678)"
}

### 32. Админка: обновление внутреннего комментария администратора к заказу
PATCH {{baseUrl}}/api/admin/orders/{{orderId}}/comment
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "comment": "Клиент просил отправить до 14:00, согласовано менеджером."
}


### =========================================================================
### Модуль аналитики дашборда (/api/admin/analytics)
### =========================================================================

### 33. Зведені показники (Summary KPI) за сьогодні (period: today)
GET {{baseUrl}}/api/admin/analytics/summary?period=today
Authorization: Bearer {{adminToken}}
Accept: application/json

### 34. Зведені показники (Summary KPI) за 7 днів (period: 7d)
GET {{baseUrl}}/api/admin/analytics/summary?period=7d
Authorization: Bearer {{adminToken}}
Accept: application/json

### 35. Графік динаміки виторгу та прибутку по днях за 7 днів
GET {{baseUrl}}/api/admin/analytics/charts/sales?period=7d&interval=day
Authorization: Bearer {{adminToken}}
Accept: application/json

### 36. Воронка замовлень за статусами та типами оплат
GET {{baseUrl}}/api/admin/analytics/orders-breakdown
Authorization: Bearer {{adminToken}}
Accept: application/json

### 37. Топ найуспішніших товарів за продажами
GET {{baseUrl}}/api/admin/analytics/top-products?limit=5
Authorization: Bearer {{adminToken}}
Accept: application/json

### 38. Алерти критичних залишків на складі (threshold <= 5 шт)
GET {{baseUrl}}/api/admin/analytics/low-stock?threshold=5
Authorization: Bearer {{adminToken}}
Accept: application/json


### =========================================================================
### Модуль фінансів та часток партнерів (/api/admin/finance)
### =========================================================================

### 39. Поточний офіційний курс долара НБУ (захист від інфляції)
GET {{baseUrl}}/api/admin/finance/exchange-rate
Authorization: Bearer {{adminToken}}
Accept: application/json

### 40. Зведення по партнерським часткам (в гривні та доларах США)
GET {{baseUrl}}/api/admin/finance/partners-summary
Authorization: Bearer {{adminToken}}
Accept: application/json

### 41. Внесення депозиту в рекламний фонд (Даниїл вносить 10 000 грн з фіксацією курсу USD)
POST {{baseUrl}}/api/admin/finance/deposits
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "adminId": "{{adminDaniilId}}",
  "amount": 10000.00,
  "currency": "UAH",
  "date": "2026-11-11T00:00:00Z",
  "note": "Поповнення рекламного фонду Google Ads"
}

### 42. Перегляд усіх внесених депозитів партнерів (з курсом долара на дату внесення)
GET {{baseUrl}}/api/admin/finance/deposits
Authorization: Bearer {{adminToken}}
Accept: application/json

### 43. Фіксація витрат на маркетинг (списання кабінету Google Shopping у грн або USD)
POST {{baseUrl}}/api/admin/finance/ad-spend
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "amount": 2800.00,
  "currency": "UAH",
  "source": "Google Shopping",
  "date": "2026-11-11T00:00:00Z",
  "note": "Поповнення кабінету Google Ads для товарної кампанії"
}

### 44. Історія витрат на рекламу (суми в UAH, USD та курс)
GET {{baseUrl}}/api/admin/finance/ad-spend
Authorization: Bearer {{adminToken}}
Accept: application/json
