@hostname = localhost
@port = 5062
@baseUrl = http://{{hostname}}:{{port}}
@supplierId = ee4c03fb-d275-4614-8cac-504493cfed52

### 1. Справочник поставщиков (проверка, что id выше реальный)
# @name getSuppliers
GET {{baseUrl}}/api/suppliers
Accept: application/json

### 2. Получить все активные категории
GET {{baseUrl}}/api/categories?onlyActive=true
Accept: application/json

### 3. Создать категорию
# Запрос создает категорию; ее ID используется в последующих запросах.
# Перед запуском измените slug, если novogodnie-ukrasheniya уже существует.
# @name createCategory
POST {{baseUrl}}/api/categories
Content-Type: application/json

{
  "name": "Новогодние украшения",
  "slug": "novogodnie-ukrasheniya",
  "parentId": null,
  "sortOrder": 1,
  "isActive": true,
  "filterSchema": null,
  "metaTitle": "Новогодние украшения",
  "metaDescription": "Ёлки, гирлянды и ёлочные игрушки"
}

### 4. Получить созданную категорию по ID
GET {{baseUrl}}/api/categories/{{createCategory.response.body.$.id}}
Accept: application/json

### 5. Найти категорию по slug (до переименования)
GET {{baseUrl}}/api/categories/by-slug/novogodnie-ukrasheniya
Accept: application/json

### 6. ОШИБКА: создать категорию с уже занятым slug (ожидается 409 Conflict)
# До PUT-переименования категория ещё держит исходный slug, поэтому
# POST с "novogodnie-ukrasheniya" обязан вернуть 409 Conflict.
POST {{baseUrl}}/api/categories
Content-Type: application/json

{
  "name": "Дубль категории",
  "slug": "{{createCategory.response.body.$.slug}}",
  "parentId": null,
  "sortOrder": 1,
  "isActive": true
}

### 7. Полностью обновить созданную категорию
# @name updateCategory
PUT {{baseUrl}}/api/categories/{{createCategory.response.body.$.id}}
Content-Type: application/json

{
  "name": "Ёлки, гирлянды и игрушки",
  "slug": "elki-girlyandy-igrushki",
  "parentId": null,
  "sortOrder": 2,
  "isActive": true,
  "filterSchema": null,
  "metaTitle": "Ёлки, гирлянды и игрушки",
  "metaDescription": "Всё для праздничного украшения дома"
}

### 8. Найти категорию по slug (после переименования)
GET {{baseUrl}}/api/categories/by-slug/elki-girlyandy-igrushki
Accept: application/json

### 9. Получить все товары (с пагинацией и сортировкой по умолчанию)
GET {{baseUrl}}/api/products
Accept: application/json

### 10. Каталог: поиск по слову
GET {{baseUrl}}/api/products?Search=гирлянда
Accept: application/json

### 11. Каталог: сортировка по возрастанию цены
GET {{baseUrl}}/api/products?SortBy=price_asc
Accept: application/json

### 12. Каталог: пагинация — страница 2 по 5 товаров
GET {{baseUrl}}/api/products?PageNumber=2&PageSize=5
Accept: application/json

### 13. Создать искусственную ёлку в новогодней категории
# Укажите ID существующего поставщика в переменной supplierId в начале файла.
# @name createProduct
POST {{baseUrl}}/api/products
Content-Type: application/json

{
  "categoryId": "{{createCategory.response.body.$.id}}",
  "supplierId": "{{supplierId}}",
  "sku": "DEMO-NEWYEAR-TREE-001",
  "name": "Искусственная ёлка 180 см",
  "slug": "iskusstvennaya-elka-180-sm",
  "description": "Пышная искусственная ёлка для новогоднего праздника",
  "dropPrice": 2500.00,
  "price": 3999.00,
  "oldPrice": 4499.00,
  "stock": 12,
  "mainImageUrl": "https://images.unsplash.com/photo-1512389142860-9c449e58a543?auto=format&fit=crop&w=1200&q=80",
  "attributes": null,
  "metaTitle": "Искусственная ёлка 180 см",
  "metaDescription": "Пышная искусственная ёлка для дома",
  "weightKg": 5.5,
  "isActive": true,
  "images": [
    {
      "url": "https://images.unsplash.com/photo-1512389142860-9c449e58a543?auto=format&fit=crop&w=1200&q=80",
      "alt": "Искусственная ёлка 180 см",
      "sortOrder": 0
    }
  ]
}

