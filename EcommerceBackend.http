@hostname = localhost
@port = 5062
@baseUrl = http://{{hostname}}:{{port}}
@supplierId = 00000000-0000-0000-0000-000000000001

### Получить все активные категории
GET {{baseUrl}}/api/categories?onlyActive=true
Accept: application/json

### Создать категорию
# Запрос создает категорию; ее ID используется в последующих запросах.
# Перед запуском измените slug, если novogodnie-ukrasheniya уже существует.
# @name createCategory
POST {{baseUrl}}/api/categories
Content-Type: application/json

{
  "name": "Новогодние украшения",
  "slug": "novogodnie-ukrasheniya",
  "parentId": null,
  "sortOrder": 1,
  "isActive": true,
  "filterSchema": null,
  "metaTitle": "Новогодние украшения",
  "metaDescription": "Ёлки, гирлянды и ёлочные игрушки"
}

### Получить созданную категорию по ID
GET {{baseUrl}}/api/categories/{{createCategory.response.body.$.id}}
Accept: application/json

### Найти категорию по slug
GET {{baseUrl}}/api/categories/by-slug/novogodnie-ukrasheniya
Accept: application/json

### Полностью обновить созданную категорию
PUT {{baseUrl}}/api/categories/{{createCategory.response.body.$.id}}
Content-Type: application/json

{
  "name": "Ёлки, гирлянды и игрушки",
  "slug": "elki-girlyandy-igrushki",
  "parentId": null,
  "sortOrder": 2,
  "isActive": true,
  "filterSchema": null,
  "metaTitle": "Ёлки, гирлянды и игрушки",
  "metaDescription": "Всё для праздничного украшения дома"
}

### Получить все товары (с пагинацией и сортировкой по умолчанию)
GET {{baseUrl}}/api/products
Accept: application/json

### Создать искусственную ёлку в новогодней категории
# Укажите ID существующего поставщика в переменной supplierId в начале файла.
# @name createProduct
POST {{baseUrl}}/api/products
Content-Type: application/json

{
  "categoryId": "{{createCategory.response.body.$.id}}",
  "supplierId": "{{supplierId}}",
  "sku": "DEMO-NEWYEAR-TREE-001",
  "name": "Искусственная ёлка 180 см",
  "slug": "iskusstvennaya-elka-180-sm",
  "description": "Пышная искусственная ёлка для новогоднего праздника",
  "dropPrice": 2500.00,
  "price": 3999.00,
  "oldPrice": 4499.00,
  "stock": 12,
  "mainImageUrl": "https://images.unsplash.com/photo-1512389142860-9c449e58a543?auto=format&fit=crop&w=1200&q=80",
  "attributes": null,
  "metaTitle": "Искусственная ёлка 180 см",
  "metaDescription": "Пышная искусственная ёлка для дома",
  "weightKg": 5.5,
  "isActive": true,
  "images": [
    {
      "url": "https://images.unsplash.com/photo-1512389142860-9c449e58a543?auto=format&fit=crop&w=1200&q=80",
      "alt": "Искусственная ёлка 180 см",
      "sortOrder": 0
    }
  ]
}

