# ==============================================================================
# EcommerceBackend Environment Variables Example
# Скопируйте этот файл в .env или настройте эти переменные в GitHub Secrets / Docker / Cloud Provider
# ==============================================================================

# Строка подключения к PostgreSQL (формат URI или стандартный Npgsql)
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/ecommerce_db?sslmode=require
# Либо стандартный формат ConnectionStrings:Default
# ConnectionStrings__Default=Host=localhost;Port=5432;Database=ecommerce_db;Username=postgres;Password=YOUR_PASSWORD;SSL Mode=Require

# JWT Секрет для авторизации администратора (минимум 32 символа!)
Jwt__Secret=REPLACE_WITH_MIN_32_CHAR_SECRET_KEY_IN_PRODUCTION!
Jwt__Issuer=EcommerceBackend
Jwt__Audience=EcommerceAdmin
Jwt__ExpiryHours=24

# Интеграция с API Новой Почты
NovaPoshta__BaseUrl=https://api.novaposhta.ua/v2.0/json/
NovaPoshta__ApiKey=YOUR_NOVA_POSHTA_API_KEY

# CORS: разрешенные домены фронтенда (через запятую или в виде массива)
Cors__AllowedOrigins__0=http://localhost:3000
Cors__AllowedOrigins__1=http://localhost:5173
